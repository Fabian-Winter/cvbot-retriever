@startuml
left to right direction

actor "Visitor" as user
cloud "AWS Bedrock\n(embeddings + LLM)" as bedrock
cloud "GitHub Actions\n(deploy.yml, OIDC)" as gha

rectangle "AWS Account" {
  component "API Gateway\n(HTTP API, $default stage,\nthrottling)" as apigw
  component "VPC Link" as vpclink
  component "Cloud Map\n(cvbot.internal)" as cloudmap

  package "ECS Cluster (Fargate)" {
    component "webapp service\n(cvbot-retriever)" as webapp {
      component "__main__\n(--serve)" as main
      component "webapp\n(FastAPI app)" as web
      component "pipeline\n(ConversationEngine)" as pipeline
      component "query_condensation" as condensation
      component "retriever" as retriever
      component "llm\n(BedrockLLMClient)" as llm
      component "vector_store" as vstore
    }
    component "chroma service\n(ChromaDB)" as chroma
  }

  component "ECR\n(cvbot-webapp)" as ecr
}

user --> apigw : HTTPS
apigw --> vpclink
vpclink --> cloudmap : webapp (SRV)
cloudmap --> web : routes to task
webapp --> cloudmap : resolves\nchroma.cvbot.internal
cloudmap --> chroma : A record
ecr --> webapp : container image

gha --> ecr : push image
gha ..> webapp : register task definition,\nupdate service

main --> web : create_app
web --> pipeline : answer
pipeline --> condensation : standalone query,\nboost fields
pipeline --> retriever : retrieve
pipeline --> llm : generate
pipeline --> vstore : open collection
retriever --> vstore : similarity search
condensation --> llm : generate_json

vstore --> chroma : HTTP\n(CHROMA_HOST:CHROMA_PORT)
vstore ..> bedrock : embed_query
llm ..> bedrock : Converse API

note bottom of chroma
  The collection is written by
  cvbot-embedder; the webapp only reads it.
end note
@enduml
